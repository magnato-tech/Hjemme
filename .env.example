# Firebase (kopier til .env og fyll inn verdier fra Firebase Console)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_FIRESTORE_DATABASE_ID=your-firestore-database-id
VITE_GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com

# Valgfritt (ikke i bruk ennå)
GEMINI_API_KEY=MY_GEMINI_API_KEY
APP_URL=MY_APP_URL
